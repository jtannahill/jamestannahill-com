# Cloudflare Workers Assets applies these to prerendered static pages.
# SSR routes also get headers from src/middleware.ts (defense-in-depth).

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(self), camera=(), cross-origin-isolated=(), display-capture=(), encrypted-media=(self), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(self), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com https://challenges.cloudflare.com https://static.cloudflareinsights.com https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.jamestannahill.com; font-src 'self' https://fonts.jamestannahill.com data:; img-src 'self' https: data: blob:; media-src 'self' https://media.jamestannahill.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://www.google-analytics.com https://*.googletagmanager.com https://stats.g.doubleclick.net https://challenges.cloudflare.com https://*.clarity.ms https://email.us-east-1.amazonaws.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

# Profile landing page (moved from /resume, which is now an SSR 301 stub).
# The HTML carries <meta name="robots" content="noindex, nofollow"> and this
# makes the header agree. The /* block deliberately does NOT set X-Robots-Tag:
# "index, follow" is already the default, so stating it globally bought
# nothing and collided with the noindex rules below (the page was serving
# both answers at once, seen 2026-08-13).
/profile
  X-Robots-Tag: noindex, nofollow

# Executive profile PDF: shareable via direct link, but kept out of search
# indexes. inline => still opens in-browser; filename => recruiter's save
# dialog and downloads use a professional name instead of "profile.pdf".
/profile.pdf
  X-Robots-Tag: noindex, nofollow
  Content-Disposition: inline; filename="James_Tannahill_Executive_Profile.pdf"

# Agent discovery (RFC 8288 Link + RFC 9727 api-catalog). Homepage-only, so a
# crawler that fetches nothing but `/` still finds the catalog, the OpenAPI
# description, and the entity docs. Mirrored in src/middleware.ts for the SSR
# path; keep the two in sync (constant lives in src/lib/security-headers.ts).
# One comma-separated field value == repeated Link headers per RFC 8288.
/
  Link: </.well-known/api-catalog>; rel="api-catalog"; type="application/linkset+json", </openapi.json>; rel="service-desc"; type="application/json", </llms.txt>; rel="service-doc"; type="text/plain", </llms-full.txt>; rel="describedby"; type="text/plain"

/.well-known/*
  Cache-Control: public, max-age=86400

# Extensionless, so Workers Assets would otherwise guess. RFC 9727 mandates
# application/linkset+json for the catalog document.
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=86400

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/scripts/*
  Cache-Control: public, max-age=0, must-revalidate

/*.avif
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable
