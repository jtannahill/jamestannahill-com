---
const navLinks = [
  { label: 'About', href: '/' },
  { label: 'Insights', href: 'https://www.plocamium.com/globals', external: true },
  { label: 'The Agency', href: 'https://www.1nessagency.com/', external: true },
  { label: 'RDLB', href: 'https://www.rdlb.nyc/', external: true },
  { label: 'Thoughts', href: '/thoughts' },
  { label: 'Contact', href: '/contact' },
];
// Active state is resolved server-side for the first paint and re-applied
// client-side after view transitions (the header is transition:persist).
const path = Astro.url.pathname;
const isActive = (href: string) => href !== '/' && path.startsWith(href);
---
<header transition:persist class="fixed top-0 left-0 right-0 z-50 bg-black/80 backdrop-blur-md border-b border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-6 h-13 flex items-center justify-between">
    <a href="/" class="font-bold tracking-widest uppercase text-white"
       style="font-family:'NHG Display',sans-serif; font-size:clamp(20px,5vw,35px);">
      James Tannahill
    </a>
    <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
      {navLinks.map(link => (
        <a
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
          data-nav-link={link.external ? undefined : link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class={`nav-link min-h-[44px] inline-flex items-center text-[12px] tracking-[0.16em] uppercase transition-colors ${
            link.label === 'Contact'
              ? 'nav-cta text-[var(--color-amber)] hover:text-[var(--color-amber-dark)]'
              : 'text-white/60 hover:text-white'
          }`}
        >
          {link.label}
          {link.external && <span class="sr-only"> (opens in new tab)</span>}
        </a>
      ))}
    </nav>
    <button id="menu-toggle" type="button"
            class="relative z-[70] md:hidden min-w-[48px] min-h-[48px] p-3 -mr-1 text-white inline-flex flex-col items-center justify-center"
            aria-label="Toggle menu" aria-controls="mobile-menu" aria-expanded="false">
      <span class="burger" aria-hidden="true">
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
        <span class="burger-bar"></span>
      </span>
    </button>
  </div>
</header>

<!-- Mobile full-screen overlay. Solid ink so the page behind cannot show through. -->
<div id="mobile-menu" transition:persist
     class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 md:hidden"
     style="background:#0a0a0a;"
     hidden>
  {navLinks.map(link => (
    <a
      href={link.href}
      target={link.external ? '_blank' : undefined}
      rel={link.external ? 'noopener noreferrer' : undefined}
      data-nav-link={link.external ? undefined : link.href}
      aria-current={isActive(link.href) ? 'page' : undefined}
      class={`nav-link text-sm tracking-[0.2em] uppercase min-h-[48px] flex items-center transition-colors ${
        link.label === 'Contact'
          ? 'nav-cta text-[var(--color-amber)]'
          : 'text-white/60 hover:text-white'
      }`}
    >
      {link.label}
      {link.external && <span class="sr-only"> (opens in new tab)</span>}
    </a>
  ))}
</div>

<style>
  /* Overlay: short ease-out entrance, faster exit. */
  #mobile-menu {
    opacity: 1;
    transform: scale(1);
    transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out), visibility 0s;
  }
  #mobile-menu[hidden] {
    display: flex;
    visibility: hidden;
    opacity: 0;
    transform: scale(0.98);
    pointer-events: none;
    transition: opacity 140ms var(--ease-out), transform 140ms var(--ease-out), visibility 0s 140ms;
  }
  @media (min-width: 768px) { #mobile-menu, #mobile-menu[hidden] { display: none; } }
  /* Hamburger folds into an X. */
  .burger { position: relative; display: block; width: 20px; height: 14px; }
  .burger-bar {
    position: absolute; left: 0; width: 20px; height: 1px; background: currentColor;
    transition: transform 200ms var(--ease-out), opacity 120ms var(--ease-out);
  }
  .burger-bar:nth-child(1) { top: 0; }
  .burger-bar:nth-child(2) { top: 50%; }
  .burger-bar:nth-child(3) { top: 100%; }
  #menu-toggle[aria-expanded="true"] .burger-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  #menu-toggle[aria-expanded="true"] .burger-bar:nth-child(2) { opacity: 0; }
  #menu-toggle[aria-expanded="true"] .burger-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu, #mobile-menu[hidden] { transform: none; transition: opacity 120ms ease, visibility 0s; }
    .burger-bar { transition: none; }
  }
  .nav-link { position: relative; }
  .nav-link:not(.nav-cta)[aria-current="page"] { color: #fff; }
  .nav-link[aria-current="page"]::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -6px;
    height: 1px;
    background: var(--color-amber);
  }
</style>

<script>
  // Keep aria-current honest across client-side navigations.
  function syncActive() {
    const path = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]').forEach((a) => {
      const href = a.getAttribute('data-nav-link') || '';
      const active = href !== '/' && path.startsWith(href);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  document.addEventListener('astro:page-load', syncActive);
  syncActive();

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  function setMenuOpen(open: boolean) {
    if (!menu || !toggle) return;
    const wasOpen = toggle.getAttribute('aria-expanded') === 'true';
    if (open) menu.removeAttribute('hidden');
    else menu.setAttribute('hidden', '');
    document.body.classList.toggle('overflow-hidden', open);
    // The overlay covers the page; keep Tab from walking into what is behind it.
    document.querySelector('main')?.toggleAttribute('inert', open);
    document.querySelector('body > footer')?.toggleAttribute('inert', open);
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    // Focus follows the menu in, and returns to the toggle on close.
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (wasOpen) toggle.focus();
  }
  toggle?.addEventListener('click', () => {
    setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => setMenuOpen(false)),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenuOpen(false);
  });
</script>
