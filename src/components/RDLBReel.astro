---
const cdn = 'https://media.jamestannahill.com';
---
<style>
  .rdlb-video { max-height: 50vh; object-fit: contain; display: block; }
  @media (min-width: 768px) { .rdlb-video { max-height: 80vh; } }
</style>
<section style="background:#000; border-top: 1px solid rgba(201,136,42,0.2); border-bottom: 1px solid rgba(201,136,42,0.2);">
  <div class="max-w-6xl mx-auto px-6 md:px-14 pt-12 md:pt-16 pb-8">
    <h2 class="sec-h text-white mb-4">RDLB brand equity capsule</h2>
    <p class="text-[15px] leading-[1.75]" style="color:rgba(255,255,255,0.6); max-width:560px;">
      A short film from RDLB, the strategic brand architecture studio James advises.
    </p>
  </div>
  <video
    poster={`${cdn}/rdlb-poster.jpg`}
    muted
    loop
    playsinline
    controls
    preload="metadata"
    class="rdlb-video w-full"
    x-webkit-airplay="allow"
  >
    <source src={`${cdn}/rdlb-brand-equity-capsule-1080.mp4`} type="video/mp4" media="(min-width: 768px)" />
    <source src={`${cdn}/rdlb-brand-equity-capsule-720.mp4`} type="video/mp4" />
  </video>
</section>

<script>
  // Muted autoplay while the reel is on screen; paused off screen. Skipped under
  // reduced motion (the controls still work). Must target .rdlb-video: a bare
  // 'section video' matches the hero scrub clip first on the homepage.
  const vid = document.querySelector<HTMLVideoElement>('.rdlb-video');
  if (vid && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) vid.play().catch(() => {});
      else vid.pause();
    }, { threshold: 0.25 }).observe(vid);
  }
</script>
