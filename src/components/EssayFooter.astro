---
// Standard chrome at the end of every /thoughts essay: previous/next by date
// first (the next thing to read), then the author line, then share and back link.
import { getPost, neighbors, readingMinutes, dayDate } from '../data/thoughts';

interface Props {
  slug: string;
}
const { slug } = Astro.props as Props;
const post = getPost(slug);
if (!post) throw new Error(`EssayFooter: unknown slug "${slug}"`);
const url = `https://jamestannahill.com/thoughts/${slug}`;
const { newer, older } = neighbors(slug);
const shareText = encodeURIComponent(`${post.title}, by James Tannahill`);
const encUrl = encodeURIComponent(url);
---
<footer class="mt-16 pt-8 border-t t-rule-strong" data-essay-footer>

  {(newer || older) && (
    <nav class="grid sm:grid-cols-2 gap-px t-plate" aria-label="Neighbouring essays">
      {newer ? (
        <a href={`/thoughts/${newer.slug}`} class="e-nav-link">
          <span class="t-eyebrow">Newer</span>
          <span class="e-nav-title">{newer.title}</span>
          <span class="e-nav-meta">{dayDate(newer.published)} · {readingMinutes(newer.slug)} min</span>
        </a>
      ) : <span class="e-nav-link e-nav-empty" aria-hidden="true"><span class="t-eyebrow">Newer</span><span class="e-nav-meta">This is the latest essay</span></span>}
      {older ? (
        <a href={`/thoughts/${older.slug}`} class="e-nav-link e-nav-right">
          <span class="t-eyebrow">Older</span>
          <span class="e-nav-title">{older.title}</span>
          <span class="e-nav-meta">{dayDate(older.published)} · {readingMinutes(older.slug)} min</span>
        </a>
      ) : <span class="e-nav-link e-nav-right e-nav-empty" aria-hidden="true"><span class="t-eyebrow">Older</span><span class="e-nav-meta">This is the first essay</span></span>}
    </nav>
  )}

  <div class="mt-10 flex items-start gap-4">
    <img src="/headshot.webp" alt="" width="44" height="44" class="rounded-full shrink-0" loading="lazy" decoding="async" style="width:44px;height:44px;object-fit:cover;" />
    <p class="text-[13px] leading-[1.7] t-body" style="text-wrap:pretty;">
      <span class="font-bold t-ink">James Tannahill</span> writes here occasionally, when there is something worth saying. AI/ML for Capital Markets at SpaceXAI. Former President and Managing Partner, Plocamium Holdings. <a href="/" class="t-amber hover:opacity-70">About</a>.
    </p>
  </div>

  <div class="mt-8 pt-6 border-t t-rule flex flex-wrap items-center justify-between gap-y-4 gap-x-6">
    <div class="flex items-center gap-5">
      <span class="t-eyebrow">Share</span>
      <a class="e-share" href={`https://x.com/intent/post?text=${shareText}&url=${encUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">X</a>
      <a class="e-share" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">LinkedIn</a>
      <a class="e-share" href={`mailto:?subject=${shareText}&body=${encUrl}`} aria-label="Share by email">Email</a>
      <button type="button" class="e-share" data-copy-link={url} aria-live="polite">Copy link</button>
    </div>
    <a href="/thoughts" class="e-share">All essays</a>
  </div>
</footer>

<style>
  .e-share {
    color: var(--t-muted);
    background: none;
    border: 0;
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    letter-spacing: 0.14em;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    /* A one-letter label (X) still gets a target wider than its glyph. */
    min-width: 24px;
    padding: 0 4px;
    margin: 0 -4px;
  }
  .e-share:active { opacity: 0.6; }
  .e-share:hover { color: var(--t-amber); }
  .e-share:focus-visible { color: var(--t-amber); outline: 2px solid var(--t-amber); outline-offset: 3px; }
  .e-share[data-copied="true"] { color: var(--t-amber); }
  .e-nav-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 22px;
    background: var(--t-bg);
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .e-nav-right { text-align: right; align-items: flex-end; }
  a.e-nav-link:hover { background: var(--t-plate); }
  a.e-nav-link:focus-visible { background: var(--t-plate); outline: 2px solid var(--t-amber); outline-offset: -2px; }
  a.e-nav-link:hover .e-nav-title { color: var(--t-amber); }
  .e-nav-title {
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--t-ink);
    text-wrap: balance;
    transition: color 0.2s ease;
  }
  .e-nav-meta { font-size: 11px; color: var(--t-muted); }
  .e-nav-empty { opacity: 0.6; }
</style>
