---
import { faqs } from '../data/faqs';
---
<div class="mt-16 pt-12" style="border-top:1px solid rgba(255,255,255,0.1);">
  <h2 class="sec-h text-white mb-8">Frequently asked</h2>
  <div style="border-bottom:1px solid rgba(255,255,255,0.08);">
    {faqs.map((faq) => (
      <details class="group py-5" style="border-top:1px solid rgba(255,255,255,0.08);">
        <summary class="flex justify-between items-start cursor-pointer list-none gap-4 min-h-[48px] py-1">
          <h3 class="font-medium leading-relaxed text-white" style="font-size:15px; overflow-wrap:break-word;">{faq.q}</h3>
          <span class="faq-plus mt-0.5 flex-shrink-0 group-open:rotate-45"
                style="color:var(--color-amber);">+</span>
        </summary>
        <p class="mt-4 text-sm leading-relaxed max-w-3xl" style="color:rgba(255,255,255,0.6);">{faq.a}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq-plus { transition: transform 200ms var(--ease-out); }
  /* The panel opens with the plus sign instead of popping. Browsers without
     interpolate-size simply snap, which is what they did before. */
  details { interpolate-size: allow-keywords; }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    opacity: 0;
    transition: block-size 220ms var(--ease-out), opacity 220ms var(--ease-out), content-visibility 220ms allow-discrete;
  }
  details[open]::details-content { block-size: auto; opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .faq-plus { transition: none; }
    details::details-content { transition: opacity 150ms ease; }
  }
</style>
