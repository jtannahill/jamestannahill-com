---
// Standard chrome at the top of every /thoughts essay: eyebrow, title, deck,
// date + reading time, and the reading-progress bar. Reading time is derived
// from the essay source at build time (see src/data/thoughts.ts).
import { getPost, readingMinutes } from '../data/thoughts';

interface Props {
  slug: string;
}
const { slug } = Astro.props as Props;
const post = getPost(slug);
if (!post) throw new Error(`EssayHeader: unknown slug "${slug}" (add it to src/data/thoughts.ts)`);
const minutes = readingMinutes(slug);
---
<div class="e-progress" data-essay-progress aria-hidden="true"></div>

<p class="t-eyebrow mb-4">
  <a href="/thoughts" class="hover:opacity-70 t-amber">Thoughts</a>
</p>
{Astro.slots.has('title') ? (
  <slot name="title" />
) : (
  <h1 class="text-[30px] sm:text-[34px] leading-[1.15] font-semibold tracking-tight mb-3 t-ink" style="text-wrap:balance;">{post.title}</h1>
)}
<p class="text-[18px] leading-[1.45] mb-4 t-deck" style="text-wrap:pretty;">{post.standfirst}</p>
<p class="text-[12px] mb-12 t-muted">
  <time datetime={post.published}>{post.date}</time>
  <span aria-hidden="true" class="mx-2">·</span>
  <span>{minutes} min read</span>
</p>

<script src="/scripts/thoughts-reading.js" defer></script>
