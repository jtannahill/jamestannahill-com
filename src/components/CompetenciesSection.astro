---
const competencies = [
  {
    title: 'Capital & Financial Architecture',
    practices: ['Strategic finance', 'Capital deployment', 'Investment structuring', 'M&A advisory'],
  },
  {
    title: 'Applied Intelligence',
    practices: ['AI systems architecture', 'ML pipelines', 'Intelligent automation', 'Data infrastructure'],
  },
  {
    title: 'AI Strategy & Enablement',
    practices: ['AI strategy', 'AI enablement', 'AI/ML in finance', 'Regulated industries', 'Capital markets'],
  },
  {
    title: 'Operational Engineering',
    practices: ['Post-transaction integration', 'Organizational architecture', 'Operational transformation'],
  },
  {
    title: 'Brand & Market Positioning',
    practices: ['Brand architecture', 'Narrative positioning', 'Market differentiation'],
  },
  {
    title: 'Regulatory & Data Systems',
    practices: ['Regulatory-compliant growth', 'Digital infrastructure', 'Data systems'],
  },
  {
    title: 'Leadership & Decision Design',
    practices: ['Decision design', 'Leadership frameworks', 'Organizational operating models'],
  },
];
---
<style>
  .comp-index {
    position: relative;
    padding-left: 22px;
  }
  /* One continuous spine for the whole list, instead of a rule on every card. */
  .comp-index::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--color-amber-subtle);
  }
  .comp-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px 32px;
    padding: 20px 0;
    border-top: 1px solid #e0ddd6;
  }
  .comp-row:first-child {
    border-top: 0;
  }
  /* The spine lights up only at the row being read. */
  .comp-row::before {
    content: '';
    position: absolute;
    left: -22px;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--color-amber);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .comp-row:hover::before,
  .comp-row:focus-within::before {
    transform: scaleY(1);
  }
  .comp-title {
    font-family: 'NHG Display', sans-serif;
    font-size: clamp(19px, 2.5vw, 28px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: #0a0a0a;
    transition: transform 0.28s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .comp-row:hover .comp-title,
  .comp-row:focus-within .comp-title {
    transform: translateX(4px);
  }
  .comp-practices {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px 28px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8a857e;
    line-height: 1.7;
  }
  @media (min-width: 768px) {
    .comp-index {
      padding-left: 28px;
    }
    .comp-row {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      align-items: baseline;
      padding: 26px 0;
    }
    .comp-row::before {
      left: -28px;
    }
    .comp-practices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .comp-row::before,
    .comp-title {
      transition: none;
    }
  }
</style>
<section class="border-t border-[#e8e5de]" style="background:#f2f0eb;">
  <div class="max-w-6xl mx-auto px-6 md:px-14 py-12 md:py-16">
    <h2 class="tracking-[0.2em] uppercase mb-8 md:mb-10" style="font-size:17px; color:var(--color-amber);">Competencies</h2>
    <div class="comp-index">
      {competencies.map((c, i) => (
        <div class="sr comp-row" style={`transition-delay: ${i * 60}ms;`}>
          <h3 class="comp-title">{c.title}</h3>
          <ul class="comp-practices">
            {c.practices.map((p) => (<li>{p}</li>))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
