---
const competencies = [
  {
    title: 'Capital & Financial Architecture',
    practices: ['Strategic finance', 'Capital deployment', 'Investment structuring', 'M&A advisory'],
  },
  {
    title: 'Applied Intelligence',
    practices: ['AI systems architecture', 'ML pipelines', 'Intelligent automation', 'Data infrastructure'],
  },
  {
    title: 'AI in Regulated Markets',
    practices: ['Capital markets', 'Healthcare and life sciences', 'Model governance', 'Compliant deployment'],
  },
  {
    title: 'Operational Engineering',
    practices: ['Post-transaction integration', 'Organizational architecture', 'Operational transformation'],
  },
  {
    title: 'Leadership & Decision Design',
    practices: ['Board and executive advisory', 'Operating cadence', 'Incentive design'],
  },
];
---
<style>
  .comp-section {
    /* Marine ramp — the row tint is mixed between these two endpoints. */
    --comp-ground: #ffffff;
    --comp-rule: rgba(11, 33, 36, 0.14);
    --comp-accent: #1d5c63;
    --comp-tint-cool: #eef2f2;
    --comp-tint-deep: #0f3b43;
    --comp-ink-cool: #0b2124;
    --comp-ink-deep: #eaf4f5;
    --comp-sub-cool: #4a6265;
    --comp-sub-deep: #a8c9cc;
    background: var(--comp-ground);
  }

  .comp-eyebrow {
    color: var(--comp-accent);
  }

  .comp-index {
    border-top: 1px solid var(--comp-rule);
  }

  .comp-row {
    /* Scroll-driven intensity, 0 (cool) to 1 (deep). Written by the script below. */
    --i: 0;
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px 32px;
    padding: 24px 20px 26px;
    border-bottom: 1px solid var(--comp-rule);
    /* Ground and ink flip together as one step (--k) once a row is near the
       reading line. A continuous mix would pass through a mid-teal band where
       neither ink clears 4.5:1, so the row is either cool or deep, never
       between. The short transition covers the flip; the spine stays
       continuous and is driven per frame by the script. */
    --k: clamp(0, calc((var(--i) - 0.55) * 100), 1);
    background: color-mix(in oklab, var(--comp-tint-deep) calc(var(--k) * 100%), var(--comp-tint-cool));
    color: color-mix(in oklab, var(--comp-ink-deep) calc(var(--k) * 100%), var(--comp-ink-cool));
    transition: background 120ms ease, color 120ms ease;
  }

  /* The spine lights in proportion to the same intensity. */
  .comp-row::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--comp-accent);
    transform: scaleY(var(--i));
    transform-origin: center;
  }

  .comp-title {
    margin: 0;
    font-family: 'NHG Display', sans-serif;
    font-size: clamp(19px, 2.5vw, 28px);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .comp-practices {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px 28px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.7;
    color: color-mix(in oklab, var(--comp-sub-deep) calc(var(--k) * 100%), var(--comp-sub-cool));
    transition: color 120ms ease;
  }

  @media (min-width: 768px) {
    .comp-row {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.1fr);
      align-items: baseline;
      padding: 30px 24px 32px;
    }
    .comp-practices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

</style>
<section class="comp-section border-t border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-6 md:px-14 py-12 md:py-16">
    <h2 class="sec-h mb-8 md:mb-10">Competencies</h2>
    <div class="comp-index" data-comp-index>
      {competencies.map((c) => (
        <div class="comp-row">
          <h3 class="comp-title">{c.title}</h3>
          <ul class="comp-practices">
            {c.practices.map((p) => (<li>{p}</li>))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  // Bundled module: runs once per document, so it re-binds on every
  // astro:page-load (ClientRouter) and unbinds on astro:before-swap.
  var teardown = function () {};
  function init() {
    teardown();
    var rows = Array.prototype.slice.call(
      document.querySelectorAll('[data-comp-index] .comp-row')
    );
    if (!rows.length) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Static fallback: a plain top-to-bottom ramp, no scroll coupling.
    function paintStatic() {
      rows.forEach(function (row, n) {
        row.style.setProperty('--i', (n / (rows.length - 1)).toFixed(3));
      });
    }

    // The reading line sits a little above centre, where the eye actually rests.
    var FOCUS = 0.42;
    // How far from the reading line a row still picks up tint, in viewport heights.
    var FALLOFF = 0.55;

    function paint() {
      var vh = window.innerHeight;
      var focusY = vh * FOCUS;
      var reach = vh * FALLOFF;
      // All reads first, then all writes, so the loop never forces layout.
      var boxes = rows.map(function (r) { return r.getBoundingClientRect(); });
      boxes.forEach(function (box, n) {
        var d = Math.abs(box.top + box.height / 2 - focusY) / reach;
        var i = Math.max(0, 1 - d);
        // Ease so the deep end concentrates on one or two rows, not a smear.
        i = i * i * (3 - 2 * i);
        rows[n].style.setProperty('--i', i.toFixed(3));
      });
    }

    var queued = false;
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(function () {
        queued = false;
        paint();
      });
    }

    function start() {
      if (reduced.matches) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        paintStatic();
        return;
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      paint();
    }

    if (reduced.addEventListener) reduced.addEventListener('change', start);
    start();
    teardown = function () {
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      if (reduced.removeEventListener) reduced.removeEventListener('change', start);
      teardown = function () {};
    };
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', function () { teardown(); });
</script>
