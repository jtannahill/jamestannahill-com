---
import { ventures } from '../data/ventures';

// The platform count reads from the same list the Ventures grid renders,
// so the stat and the grid below it can never disagree.
const stats = [
  { n: String(ventures.length), l: 'Active platforms' },
  { n: '4', l: 'Regulated sectors' },
  { n: '10+', l: 'Years operating' },
  { n: '3rd', l: 'Generation family firm' },
];
---
<style>
  .stat { background: #fff; padding: 28px 24px; }
  .stat-n {
    font-size: clamp(40px, 5vw, 56px);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-l {
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-top: 10px;
  }
</style>
<section class="border-t border-[var(--color-border)] bg-white">
  <div class="max-w-6xl mx-auto px-6 md:px-14 py-12 md:py-16">
    <h2 class="sec-h mb-8">Active systems</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-[var(--color-border)] mb-10 md:mb-12">
      {stats.map((s) => (
        <div class="stat">
          <p class="stat-n">{s.n}</p>
          <p class="stat-l">{s.l}</p>
        </div>
      ))}
    </div>

    <div class="border-t border-[var(--color-border)] pt-10">
      <h3 class="sec-h mb-4" style="font-size:22px;">Operating partnerships</h3>
      <p class="leading-relaxed" style="color:#555; max-width:640px;">
        James works with RDLB on brand architecture and with 1nessAgency on growth for regulated industries, and brings both into the platforms above.
      </p>
    </div>
  </div>
</section>
