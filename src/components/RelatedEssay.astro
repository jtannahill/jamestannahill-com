---
interface Essay {
  href: string;
  title: string;
  blurb: string;
}

interface Props {
  essays: Essay[];
  label?: string;
}

const { essays, label } = Astro.props as Props;
const heading = label ?? (essays.length > 1 ? 'Related Essays' : 'Related Essay');
---
<aside class="related-essays my-14">
  <div class="flex items-center gap-4 mb-5">
    <span class="text-[9px] tracking-[0.25em] uppercase whitespace-nowrap" style="color:var(--color-amber);">{heading}</span>
    <span class="h-px flex-1" style="background:#eae7e1;"></span>
  </div>

  {essays.map((essay) => (
    <a href={essay.href} class="related-essay group">
      <span class="related-essay-title">
        {essay.title}
        <span class="related-essay-arrow" aria-hidden="true">&rarr;</span>
      </span>
      <span class="related-essay-blurb">{essay.blurb}</span>
    </a>
  ))}
</aside>

<style>
  .related-essay {
    display: block;
    padding: 18px 22px;
    margin-bottom: 10px;
    text-decoration: none;
    background: #fbfaf8;
    border: 1px solid #ece9e3;
    border-left: 2px solid var(--color-amber);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s ease;
  }

  .related-essay:last-child {
    margin-bottom: 0;
  }

  .related-essay:hover {
    background: #fff;
    border-color: #e0dbd2;
    border-left-color: var(--color-amber);
    transform: translateX(3px);
  }

  .related-essay-title {
    display: block;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: #1a1a1a;
    margin-bottom: 5px;
    transition: color 0.25s ease;
  }

  .related-essay:hover .related-essay-title {
    color: var(--color-amber);
  }

  .related-essay-arrow {
    display: inline-block;
    margin-left: 8px;
    font-weight: 400;
    color: var(--color-amber);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .related-essay:hover .related-essay-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .related-essay-blurb {
    display: block;
    font-size: 13px;
    line-height: 1.6;
    color: #6b6b6b;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-essay,
    .related-essay-arrow {
      transition: none;
    }
    .related-essay:hover {
      transform: none;
    }
  }
</style>
