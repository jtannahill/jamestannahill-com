---
interface Essay {
  href: string;
  title: string;
  blurb: string;
}

interface Props {
  essays: Essay[];
  label?: string;
}

const { essays, label } = Astro.props as Props;
const heading = label ?? 'See Also';
---
<aside class="see-also">
  <p class="see-also-label">{heading}</p>
  <div class="see-also-list">
    {essays.map((essay) => (
      <a href={essay.href} class="see-also-item">
        <span class="see-also-title">{essay.title}</span>
        <span class="see-also-blurb">{essay.blurb}</span>
      </a>
    ))}
  </div>
</aside>

<style>
  .see-also {
    margin: 56px 0;
    padding-top: 14px;
    border-top: 1px solid #1a1a1a;
  }

  .see-also-label {
    font-size: 9px;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--color-amber);
    margin: 0 0 14px;
  }

  .see-also-item {
    display: block;
    text-decoration: none;
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid #eee;
  }

  .see-also-item:last-child {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom: 0;
  }

  .see-also-title {
    display: inline;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #1a1a1a;
    box-shadow: inset 0 -1px 0 0 #ddd;
    transition: box-shadow 0.2s ease;
  }

  .see-also-item:hover .see-also-title {
    box-shadow: inset 0 -1px 0 0 var(--color-amber);
  }

  .see-also-blurb {
    display: block;
    margin-top: 5px;
    font-size: 11px;
    line-height: 1.6;
    color: #999;
  }

  @media (min-width: 640px) {
    .see-also {
      display: grid;
      grid-template-columns: 96px 1fr;
      column-gap: 24px;
    }

    .see-also-label {
      margin-bottom: 0;
      padding-top: 3px;
    }
  }
</style>
