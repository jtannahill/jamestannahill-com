---
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  extraSchema?: Record<string, unknown>[];
  publishedTime?: string;
  articleSection?: string;
  /** Absolute URL of the above-the-fold hero image to preload (LCP). */
  preloadImage?: string;
}
const {
  title,
  description,
  canonical,
  noindex = false,
  ogImage,
  ogImageAlt,
  ogType,
  extraSchema,
  publishedTime,
  articleSection,
  preloadImage,
} = Astro.props;
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogType={ogType}
      extraSchema={extraSchema}
      publishedTime={publishedTime}
      articleSection={articleSection}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="manifest" href="/manifest.json" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {isHome && <script src="/scripts/hero-preload.js" defer></script>}
    <noscript>
      <style>
        .sr { opacity: 1 !important; transform: none !important; animation: none !important; }
      </style>
    </noscript>
    <link rel="preload" href="https://fonts.jamestannahill.com/NHGDisplay-Roman.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.jamestannahill.com/NHGDisplay-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="https://fonts.jamestannahill.com/NHGDisplay-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <ClientRouter />
    <script src="/scripts/tracking.js" defer></script>
    <script src="/scripts/analytics.js" defer></script>
    <!-- WebMCP: registers site tools on navigator.modelContext for in-browser
         agents. No-ops where the API is absent. Site-wide, so it registers once
         per document rather than on every astro:page-load. -->
    <script src="/scripts/webmcp.js" defer></script>
  </head>
  <body>
    <Header />
    <main class="pt-14" transition:animate="fade">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script src="/scripts/consent.js" defer></script>
    <script>
      // ── Scroll reveal - JS fallback for browsers without animation-timeline ──
      function initScrollReveal() {
        if (CSS.supports('animation-timeline', 'scroll()')) return;
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        document.querySelectorAll('.sr').forEach((el) => revealObserver.observe(el));
      }

      function registerServiceWorker() {
        if (!('serviceWorker' in navigator)) return;
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }

      // Event tracking itself lives in /scripts/tracking.js, which instruments
      // every page from one place: page_view, links (outbound, App Store,
      // mailto, downloads), FAQ opens, video, scroll depth and form starts.
      document.addEventListener('astro:page-load', () => {
        (window as any).jtPageView?.();
        (window as any).jtInitTracking?.();
        initScrollReveal();
      });

      // initScrollReveal runs from astro:page-load, which ClientRouter also
      // fires on the initial load - calling it here too double-binds.
      registerServiceWorker();
    </script>
  </body>
</html>
