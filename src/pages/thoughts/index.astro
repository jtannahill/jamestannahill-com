---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Essays live in src/data/thoughts.ts (newest first). The first entry runs as
// the lead plate, the rest fall into the list below it.
import { posts, readingMinutes } from '../../data/thoughts';

const [lead, ...rest] = posts;

const description = 'Occasional essays on markets, medicine, and the language both are written in.';

const schema = [
  {
    '@type': 'Blog',
    '@id': 'https://jamestannahill.com/thoughts#blog',
    url: 'https://jamestannahill.com/thoughts',
    name: 'Thoughts',
    description,
    inLanguage: 'en-US',
    author: { '@id': 'https://jamestannahill.com/#person' },
    publisher: { '@id': 'https://jamestannahill.com/#person' },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `https://jamestannahill.com/thoughts/${post.slug}#post`,
      url: `https://jamestannahill.com/thoughts/${post.slug}`,
      headline: post.title,
      alternativeHeadline: post.standfirst,
      datePublished: post.published,
      author: { '@id': 'https://jamestannahill.com/#person' },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': 'https://jamestannahill.com/thoughts#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jamestannahill.com/' },
      { '@type': 'ListItem', position: 2, name: 'Thoughts', item: 'https://jamestannahill.com/thoughts' },
    ],
  },
];
---
<BaseLayout
  title="Thoughts | James Tannahill"
  description={description}
  canonical="https://jamestannahill.com/thoughts"
  ogType="website"
  ogImage="https://jamestannahill.com/og-thoughts.png?v=4"
  ogImageAlt="Thoughts - occasional essays by James Tannahill"
  extraSchema={schema}
  preloadImage={lead.art}
>
  <div class="thoughts-page min-h-screen">
    <div class="max-w-3xl mx-auto px-6 py-16">

      <p class="t-eyebrow mb-4">Thoughts</p>
      <h1 class="text-[28px] font-semibold tracking-tight mb-2 t-ink">Thoughts</h1>
      <p class="text-[15px] leading-[1.85] mb-12 max-w-xl t-body" style="text-wrap:pretty;">
        Occasional essays. Published when there is something worth saying, not on a schedule.
      </p>

      <!-- Lead: newest essay, full width, art first. -->
      <a href={`/thoughts/${lead.slug}`} class="tcard tcard-lead group block mb-16">
        {lead.art && <div class="overflow-hidden t-plate">
          <img
            src={lead.art}
            alt={lead.artAlt}
            width="1200"
            height="675"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="tcard-img tcard-img-lead w-full object-cover"
            style={`aspect-ratio:${lead.aspect};`}
          />
        </div>}
        <div class="flex items-baseline gap-3 mt-5">
          <span class="t-eyebrow">Latest</span>
          <span class="text-[12px] t-muted">{lead.date}</span>
          <span class="text-[12px] t-muted">{readingMinutes(lead.slug)} min read</span>
        </div>
        <h2 class="tcard-title text-[30px] leading-[1.15] font-semibold tracking-tight mt-2 t-ink" style="text-wrap:balance;">
          {lead.title}
        </h2>
        <p class="text-[16px] leading-[1.7] mt-2 max-w-xl t-body" style="text-wrap:pretty;">{lead.standfirst}</p>
        <span class="tcard-cta inline-block text-[11px] tracking-[0.18em] uppercase mt-4">
          Read the essay
        </span>
      </a>

      {rest.length > 0 && (
        <div>
          <div class="flex items-baseline justify-between t-rule-strong border-t pt-4 mb-2">
            <p class="t-eyebrow">More essays</p>
            <p class="text-[12px] t-muted tabular-nums">{rest.length} earlier</p>
          </div>
          {rest.map((post, i) => (
            <a
              href={`/thoughts/${post.slug}`}
              class="tcard group grid gap-5 sm:gap-8 sm:grid-cols-12 items-start py-9 border-b t-rule"
            >
              {post.art && <div class="sm:col-span-4 overflow-hidden t-plate">
                <img
                  src={post.art}
                  alt={post.artAlt}
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="tcard-img tcard-img-row w-full object-cover"
                />
              </div>}
              <div class="sm:col-span-8">
                <div class="flex items-baseline gap-4">
                  <span class="tcard-num text-[20px] leading-none tabular-nums font-normal">
                    {String(i + 2).padStart(2, '0')}
                  </span>
                  <span class="text-[12px] t-muted">{post.date}</span>
                  <span class="text-[12px] t-muted">{readingMinutes(post.slug)} min read</span>
                </div>
                <h2 class="tcard-title text-[22px] leading-[1.25] font-semibold tracking-tight mt-2 t-ink" style="text-wrap:balance;">
                  {post.title}
                </h2>
                <p class="text-[15px] leading-[1.75] mt-2 t-body" style="text-wrap:pretty;">{post.standfirst}</p>
                <span class="tcard-cta inline-block text-[11px] tracking-[0.18em] uppercase mt-4">
                  Read the essay
                </span>
              </div>
            </a>
          ))}
        </div>
      )}

      <style>
        .tcard { border-radius: 2px; outline: none; }
        .tcard:focus-visible { box-shadow: 0 0 0 2px var(--t-bg), 0 0 0 4px var(--color-amber); }
        .tcard-img {
          transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
          filter: saturate(0.92);
        }
        .tcard-img-row { aspect-ratio: 3 / 2; }
        @media (max-width: 639px) {
          .tcard-img-lead, .tcard-img-row { aspect-ratio: 16 / 9 !important; }
        }
        .tcard:hover .tcard-img,
        .tcard:focus-visible .tcard-img {
          transform: scale(1.035);
          filter: saturate(1.05);
        }
        .tcard-title { transition: color 0.25s ease; }
        .tcard:hover .tcard-title,
        .tcard:focus-visible .tcard-title { color: var(--color-amber); }
        .tcard-num { color: var(--t-faint); }
        .tcard-cta {
          color: var(--color-amber);
          background-image: linear-gradient(var(--color-amber), var(--color-amber));
          background-repeat: no-repeat;
          background-size: 0% 1px;
          background-position: 0 100%;
          padding-bottom: 2px;
          transition: background-size 0.3s ease;
        }
        .tcard:hover .tcard-cta,
        .tcard:focus-visible .tcard-cta { background-size: 100% 1px; }
        @media (prefers-reduced-motion: reduce) {
          .tcard-img, .tcard-cta { transition: none; }
          .tcard:hover .tcard-img { transform: none; }
        }
      </style>

    </div>
  </div>
</BaseLayout>
