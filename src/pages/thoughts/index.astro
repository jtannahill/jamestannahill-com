---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Add new essays here, newest first. The first entry runs as the lead plate,
// the rest fall into the grid below it. `art` is the same artwork that opens
// the essay itself, so the index and the piece agree visually.
const posts = [
  {
    slug: 'sea-room',
    title: 'Sea Room',
    standfirst: 'On the difference between knowing where you are and having somewhere to go',
    date: 'August 2026',
    published: '2026-08-04',
    art: 'https://art.jamestannahill.com/weather/2026-08-03-060044/tropical-south-america-15s-70w/preview-1200.webp',
    artAlt: 'Abstract painting of stacked biomorphic shapes in yellow, blue and red on a peach ground',
    aspect: '16 / 9',
  },
  {
    slug: 'the-unsmiling-class',
    title: 'The Unsmiling Class',
    standfirst: 'On the finance headshot, and the face it has agreed to wear',
    date: 'August 2026',
    published: '2026-08-04',
    art: 'https://art.jamestannahill.com/weather/2026-08-03-060044/north-america-45n-120w/preview-1200.webp',
    artAlt: 'Abstract painting of soft-edged sprayed forms in red, yellow and navy on a tan ground',
    aspect: '4 / 3',
  },
  {
    slug: 'guerir-quelquefois',
    title: 'Guérir Quelquefois',
    standfirst: 'On the word "cure," and the men who sell it',
    date: 'August 2026',
    published: '2026-08-04',
    art: 'https://art.jamestannahill.com/weather/2026-08-02-060044/central-asia-45n-90e/preview-1200.webp',
    artAlt: 'Abstract painting of overlapping pale rounded shapes in grey, cream and rose',
    aspect: '4 / 3',
  },
];

const [lead, ...rest] = posts;

const description = 'Occasional essays on markets, medicine, and the language both are written in.';

const schema = [
  {
    '@type': 'Blog',
    '@id': 'https://jamestannahill.com/thoughts/#blog',
    url: 'https://jamestannahill.com/thoughts/',
    name: 'Thoughts',
    description,
    inLanguage: 'en-US',
    author: { '@id': 'https://jamestannahill.com/#person' },
    publisher: { '@id': 'https://jamestannahill.com/#person' },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `https://jamestannahill.com/thoughts/${post.slug}/#post`,
      url: `https://jamestannahill.com/thoughts/${post.slug}/`,
      headline: post.title,
      alternativeHeadline: post.standfirst,
      datePublished: post.published,
      author: { '@id': 'https://jamestannahill.com/#person' },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': 'https://jamestannahill.com/thoughts/#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jamestannahill.com/' },
      { '@type': 'ListItem', position: 2, name: 'Thoughts', item: 'https://jamestannahill.com/thoughts/' },
    ],
  },
];
---
<BaseLayout
  title="Thoughts | James Tannahill"
  description={description}
  canonical="https://jamestannahill.com/thoughts/"
  ogType="website"
  ogImage="https://jamestannahill.com/og-thoughts.png?v=4"
  ogImageAlt="Thoughts - occasional essays by James Tannahill"
  extraSchema={schema}
>
  <div class="bg-white min-h-screen">
    <div class="max-w-3xl mx-auto px-6 py-16">

      <p class="text-[9px] tracking-[0.25em] uppercase mb-4" style="color:var(--color-amber);">Thoughts</p>
      <h1 class="text-[28px] font-semibold tracking-tight mb-2" style="color:#1a1a1a;">Thoughts</h1>
      <p class="text-[15px] leading-[1.85] mb-12 max-w-xl" style="color:#444;">
        Occasional essays. Published when there is something worth saying, not on a schedule.
      </p>

      <!-- Lead: newest essay, full width, art first. -->
      <a href={`/thoughts/${lead.slug}/`} class="tcard group block mb-16">
        <div class="overflow-hidden" style="background:#f5f5f5;">
          <img
            src={lead.art}
            alt={lead.artAlt}
            width="1200"
            height="675"
            loading="eager"
            decoding="async"
            class="tcard-img w-full object-cover"
            style={`aspect-ratio:${lead.aspect};`}
          />
        </div>
        <div class="flex items-baseline gap-3 mt-5">
          <span class="text-[9px] tracking-[0.25em] uppercase" style="color:var(--color-amber);">Latest</span>
          <span class="text-[12px]" style="color:#999;">{lead.date}</span>
        </div>
        <h2 class="tcard-title text-[30px] leading-[1.15] font-semibold tracking-tight mt-2" style="color:#1a1a1a;">
          {lead.title}
        </h2>
        <p class="text-[16px] leading-[1.7] mt-2 max-w-xl" style="color:#555;">{lead.standfirst}</p>
        <span class="inline-block text-[11px] tracking-[0.18em] uppercase mt-4" style="color:var(--color-amber);">
          Read the essay
        </span>
      </a>

      {rest.length > 0 && (
        <div class="border-t" style="border-color:#eee;">
          {rest.map((post, i) => (
            <a
              href={`/thoughts/${post.slug}/`}
              class="tcard group grid gap-6 sm:gap-8 sm:grid-cols-12 items-start py-10 border-b"
              style="border-color:#eee;"
            >
              <div class="sm:col-span-5 overflow-hidden" style="background:#f5f5f5;">
                <img
                  src={post.art}
                  alt={post.artAlt}
                  width="1200"
                  height="900"
                  loading="lazy"
                  decoding="async"
                  class="tcard-img w-full object-cover"
                  style={`aspect-ratio:${post.aspect};`}
                />
              </div>
              <div class="sm:col-span-7">
                <div class="flex items-baseline gap-3">
                  <span class="text-[10px] tabular-nums" style="color:var(--color-amber);">
                    {String(i + 2).padStart(2, '0')}
                  </span>
                  <span class="text-[12px]" style="color:#999;">{post.date}</span>
                </div>
                <h2 class="tcard-title text-[22px] leading-[1.25] font-semibold tracking-tight mt-1" style="color:#1a1a1a;">
                  {post.title}
                </h2>
                <p class="text-[15px] leading-[1.75] mt-2" style="color:#555;">{post.standfirst}</p>
              </div>
            </a>
          ))}
        </div>
      )}

      <style>
        .tcard-img {
          transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
          filter: saturate(0.92);
        }
        .tcard:hover .tcard-img,
        .tcard:focus-visible .tcard-img {
          transform: scale(1.035);
          filter: saturate(1.05);
        }
        .tcard-title { transition: color 0.25s ease; }
        .tcard:hover .tcard-title,
        .tcard:focus-visible .tcard-title { color: var(--color-amber); }
        @media (prefers-reduced-motion: reduce) {
          .tcard-img { transition: none; }
          .tcard:hover .tcard-img { transform: none; }
        }
      </style>

    </div>
  </div>
</BaseLayout>
