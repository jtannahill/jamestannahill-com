---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';

// Essays live in src/data/thoughts.ts (newest first). The first entry runs as
// the lead plate, the rest fall into the list below it.
import { posts, readingMinutes, dayDate } from '../../data/thoughts';

const [lead, ...rest] = posts;

// The art host serves 480/960/1200 renditions next to preview-1200.webp, so
// thumbnails can pull the small file instead of the full plate.
const srcset = (src: string) =>
  src.endsWith('/preview-1200.webp')
    ? ['480', '960', '1200'].map((w) => `${src.replace(/1200\.webp$/, `${w}.webp`)} ${w}w`).join(', ')
    : undefined;
const leadSizes = '(min-width: 768px) 420px, calc(100vw - 48px)';
const rowSizes = '(min-width: 640px) 240px, calc(100vw - 48px)';

const description = 'Occasional essays on markets, medicine, and the language both are written in.';

const schema = [
  {
    '@type': 'Blog',
    '@id': 'https://jamestannahill.com/thoughts#blog',
    url: 'https://jamestannahill.com/thoughts',
    name: 'Thoughts',
    description,
    inLanguage: 'en-US',
    author: { '@id': 'https://jamestannahill.com/#person' },
    publisher: { '@id': 'https://jamestannahill.com/#person' },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `https://jamestannahill.com/thoughts/${post.slug}#post`,
      url: `https://jamestannahill.com/thoughts/${post.slug}`,
      headline: post.title,
      alternativeHeadline: post.standfirst,
      datePublished: post.published,
      author: { '@id': 'https://jamestannahill.com/#person' },
    })),
  },
  {
    '@type': 'BreadcrumbList',
    '@id': 'https://jamestannahill.com/thoughts#breadcrumb',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jamestannahill.com/' },
      { '@type': 'ListItem', position: 2, name: 'Thoughts', item: 'https://jamestannahill.com/thoughts' },
    ],
  },
];
---
<BaseLayout
  title="Thoughts | James Tannahill"
  description={description}
  canonical="https://jamestannahill.com/thoughts"
  ogType="website"
  ogImage="https://jamestannahill.com/og-thoughts.jpg?v=1"
  ogImageAlt="Thoughts: occasional essays by James Tannahill"
  extraSchema={schema}
  preloadImage={lead.art}
  preloadImageSrcset={srcset(lead.art)}
  preloadImageSizes={leadSizes}
>
  <div class="thoughts-page min-h-screen">
    <div class="max-w-3xl mx-auto px-6 py-16">

      <h1 class="text-[36px] leading-[1.1] font-bold tracking-tight mb-2 t-ink">Thoughts</h1>
      <p class="text-[15px] leading-[1.85] mb-12 max-w-xl t-body" style="text-wrap:pretty;">
        Occasional essays. Published when there is something worth saying, not on a schedule.
      </p>

      <!-- Lead: newest essay, full width, art first. -->
      <a href={`/thoughts/${lead.slug}`} class="tcard tcard-lead group grid gap-6 sm:gap-8 sm:grid-cols-12 sm:items-end mb-16">
        {lead.art && <div class="sm:col-span-7 overflow-hidden t-plate">
          <img
            src={lead.art}
            srcset={srcset(lead.art)}
            sizes={leadSizes}
            alt=""
            width="1200"
            height="1200"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="tcard-img tcard-img-lead photo-edge w-full object-cover"
          />
        </div>}
        <div class="sm:col-span-5">
        <div class="flex items-baseline gap-4 tabular-nums">
          <time datetime={lead.published} class="text-[12px] t-muted">{dayDate(lead.published)}</time>
          <span class="text-[12px] t-muted">{readingMinutes(lead.slug)} min read</span>
        </div>
        <h2 class="tcard-title text-[30px] leading-[1.15] font-bold tracking-tight mt-2 t-ink" style="text-wrap:balance;">
          {lead.title}
        </h2>
        <p class="text-[16px] leading-[1.7] mt-2 max-w-xl t-body" style="text-wrap:pretty;">{lead.standfirst}</p>
        <span class="tcard-cta inline-block text-[11px] tracking-[0.18em] uppercase mt-4">
          Read the essay
        </span>
        </div>
      </a>

      {rest.length > 0 && (
        <div>
          <div class="flex items-baseline justify-between t-rule-strong border-t pt-4 mb-2">
            <h2 class="text-[15px] font-medium t-ink">Earlier essays</h2>
            <p class="text-[12px] t-muted tabular-nums">{rest.length}</p>
          </div>
          <ul role="list">
          {rest.map((post) => (
            <li>
            <a
              href={`/thoughts/${post.slug}`}
              class="tcard group grid gap-5 sm:gap-8 sm:grid-cols-12 items-start py-9 border-b t-rule"
            >
              {post.art && <div class="sm:col-span-4 overflow-hidden t-plate">
                <img
                  src={post.art}
                  srcset={srcset(post.art)}
                  sizes={rowSizes}
                  alt=""
                  width="1200"
                  height="800"
                  loading="lazy"
                  decoding="async"
                  class="tcard-img tcard-img-row photo-edge w-full object-cover"
                />
              </div>}
              <div class="sm:col-span-8">
                <div class="flex items-baseline gap-4 tabular-nums">
                  <time datetime={post.published} class="text-[12px] t-muted">{dayDate(post.published)}</time>
                  <span class="text-[12px] t-muted">{readingMinutes(post.slug)} min read</span>
                </div>
                <h3 class="tcard-title text-[22px] leading-[1.25] font-bold tracking-tight mt-2 t-ink" style="text-wrap:balance;">
                  {post.title}
                </h3>
                <p class="text-[15px] leading-[1.75] mt-2 t-body" style="text-wrap:pretty;">{post.standfirst}</p>
              </div>
            </a>
            </li>
          ))}
          </ul>
        </div>
      )}

      <style>
        .tcard { border-radius: 2px; outline: none; }
        .tcard:focus-visible { box-shadow: 0 0 0 2px var(--t-bg), 0 0 0 4px var(--t-amber); }
        .tcard-img {
          transition: transform 250ms var(--ease-out), filter 250ms ease;
          filter: saturate(0.92);
        }
        .tcard-img-lead { aspect-ratio: 1 / 1; }
        .tcard-img-row { aspect-ratio: 3 / 2; }
        @media (max-width: 639px) {
          .tcard-img-row { aspect-ratio: 16 / 9; }
        }
        @media (hover: hover) and (pointer: fine) {
          .tcard:hover .tcard-img { transform: scale(1.035); filter: saturate(1.05); }
        }
        .tcard:focus-visible .tcard-img { transform: scale(1.035); filter: saturate(1.05); }
        .tcard-title { transition: color 0.25s ease; }
        .tcard:hover .tcard-title,
        .tcard:focus-visible .tcard-title { color: var(--t-amber); }
        .tcard-cta {
          color: var(--t-amber);
          background-image: linear-gradient(var(--t-amber), var(--t-amber));
          background-repeat: no-repeat;
          background-size: 0% 1px;
          background-position: 0 100%;
          padding-bottom: 2px;
          transition: background-size 0.3s ease;
        }
        .tcard:hover .tcard-cta,
        .tcard:focus-visible .tcard-cta { background-size: 100% 1px; }
        @media (prefers-reduced-motion: reduce) {
          .tcard-img, .tcard-cta { transition: none; }
          .tcard:hover .tcard-img, .tcard:focus-visible .tcard-img { transform: none; }
        }
      </style>

    </div>
  </div>
</BaseLayout>
