    description,
    image: 'https://jamestannahill.com/og-guerir-quelquefois.png?v=4',
    datePublished: published,
    dateModified: modified,
    inLanguage: 'en-US',
    articleSection: 'Essays',
    author: { '@id': 'https://jamestannahill.com/#person' },
    publisher: { '@id': 'https://jamestannahill.com/#person' },
    keywords: [
      'biotechnology pricing',
      'gene therapy',
      'cure vs treatment',
      'durable response',
      'outcomes-based warranties',
      'pharmaceutical language',
    ],
    about: [
      { '@type': 'Thing', name: 'Gene therapy pricing' },
      { '@type': 'Thing', name: 'Biotechnology investment analysis' },
      { '@type': 'Thing', name: 'Corporate disclosure language' },
    ],
    // The French title and the Trudeau aphorism both have clips on the page.
    subjectOf: [
      {
        '@type': 'AudioObject',
