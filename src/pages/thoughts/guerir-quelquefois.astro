import BaseLayout from '../../layouts/BaseLayout.astro';

const url = 'https://jamestannahill.com/thoughts/guerir-quelquefois/';
const published = '2026-08-04';
const description =
  'On the word cure, what it is hired to do in a biotechnology sentence, and who is paying its wages.';

const schema = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#post`,
    isPartOf: { '@id': 'https://jamestannahill.com/thoughts/#blog' },
    mainEntityOfPage: url,
    url,
    headline: 'Guérir Quelquefois',
    alternativeHeadline: 'On the word "cure," and the men who sell it',
    description,
    image: 'https://jamestannahill.com/og-guerir-quelquefois.png?v=4',
    datePublished: published,
    dateModified: published,
    inLanguage: 'en-US',
    articleSection: 'Essays',
    author: { '@id': 'https://jamestannahill.com/#person' },
    publisher: { '@id': 'https://jamestannahill.com/#person' },
    keywords: [
      'biotechnology pricing',
      'gene therapy',
      'cure vs treatment',
      'durable response',
      'outcomes-based warranties',
      'pharmaceutical language',
    ],
    about: [
      { '@type': 'Thing', name: 'Gene therapy pricing' },
      { '@type': 'Thing', name: 'Biotechnology investment analysis' },
      { '@type': 'Thing', name: 'Corporate disclosure language' },
    ],
    // The French title and the Trudeau aphorism both have clips on the page.
    subjectOf: [
      {
        '@type': 'AudioObject',
        name: 'Pronunciation of Guérir Quelquefois',
        contentUrl: 'https://jamestannahill.com/audio/guerir-quelquefois.mp3',
        encodingFormat: 'audio/mpeg',
        inLanguage: 'fr-FR',
      },
      {
        '@type': 'AudioObject',
        name: 'Pronunciation of Guérir quelquefois, soulager souvent, consoler toujours',
        contentUrl: 'https://jamestannahill.com/audio/guerir-soulager-consoler.mp3',
        encodingFormat: 'audio/mpeg',
        inLanguage: 'fr-FR',
      },
    ],
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://jamestannahill.com/' },
      { '@type': 'ListItem', position: 2, name: 'Thoughts', item: 'https://jamestannahill.com/thoughts/' },
      { '@type': 'ListItem', position: 3, name: 'Guérir Quelquefois', item: url },
