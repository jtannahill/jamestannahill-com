---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Page Not Found - James Tannahill"
  description="The page you're looking for doesn't exist."
  canonical="https://jamestannahill.com/404"
  noindex
>
  <div class="min-h-[80vh] flex flex-col items-center justify-center px-6 text-center">
    <h1 class="font-bold mb-4" style="font-family:'NHG Display',sans-serif; font-size:clamp(32px,6vw,56px); letter-spacing:-0.02em;">
      Page not found.
    </h1>
    <p class="mb-10 max-w-sm" style="font-size:15px; color:var(--color-muted); line-height:1.75;">
      This page doesn't exist or has moved. Head back to the main site.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a href="/"
         class="press btn-primary inline-flex items-center justify-center min-h-[48px] px-8 py-3 text-[13px] tracking-[0.18em] uppercase">
        Back to home
      </a>
      <a href="/contact"
         class="press btn-secondary btn-secondary-light inline-flex items-center justify-center min-h-[48px] px-8 py-3 text-[13px] tracking-[0.18em] uppercase border">
        Contact
      </a>
    </div>
  </div>

  <script>
    // Which URL was missed, and where the visitor came from, is the whole
    // value of a 404 report; the page itself has nothing else to say.
    document.addEventListener('astro:page-load', () => {
      (window as any).jtTrack?.('page_not_found', {
        missed_path: window.location.pathname,
        referrer: document.referrer || 'direct',
      });
    });
  </script>
</BaseLayout>
