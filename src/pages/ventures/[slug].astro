---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venturePages } from '../../data/ventures';

export function getStaticPaths() {
  return venturePages.map((v, i) => ({
    params: { slug: v.slug },
    props: {
      venture: v,
      // Prev/next walk the portfolio in its published order, wrapping at the ends.
      prev: venturePages[(i - 1 + venturePages.length) % venturePages.length],
      next: venturePages[(i + 1) % venturePages.length],
    },
  }));
}

const { venture, prev, next } = Astro.props;
const page = venture.page!;
const canonical = `https://jamestannahill.com/ventures/${venture.slug}/`;

/** Escape first, then link, so body copy can never inject markup. */
function linkify(text: string): string {
  const html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return (page.links ?? []).reduce((acc, link) => {
    const needle = link.text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    return acc.replace(
      needle,
      `<a class="v-inline" href="${link.url}" target="_blank" rel="noopener noreferrer">${needle}</a>`
    );
  }, html);
}

const schema = [
  {
    '@type': 'Organization',
    '@id': `${canonical}#organization`,
    name: venture.name,
    url: venture.url,
    description: venture.description,
  },
  {
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: page.metaTitle,
    description: page.metaDescription,
    about: { '@id': `${canonical}#organization` },
    isPartOf: { '@id': 'https://jamestannahill.com/#website' },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'James Tannahill', item: 'https://jamestannahill.com/' },
        { '@type': 'ListItem', position: 2, name: 'Ventures & Platforms', item: 'https://jamestannahill.com/#ventures' },
        { '@type': 'ListItem', position: 3, name: venture.name, item: canonical },
      ],
    },
  },
];
---
<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={canonical}
  ogImage={`https://jamestannahill.com/og-venture-${venture.slug}.png`}
  ogImageAlt={`${venture.name} - ${page.thesis}`}
  ogType="website"
  extraSchema={schema}
>
  <style>
    .v-shell {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 24px;
      /* Two voices on this page: NHG Display carries the argument, this mono
         carries anything that is navigation or record. */
      --v-mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
    }

    .v-crumb {
      border-bottom: 1px solid var(--color-border);
      padding: 18px 0;
      font-family: var(--v-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #8a857e;
    }
    .v-crumb a { color: #8a857e; text-decoration: none; }
    .v-crumb a:hover { color: var(--color-amber); }

    .v-title {
      margin: 52px 0 18px;
      font-family: 'NHG Display', sans-serif;
      font-size: clamp(36px, 6.5vw, 64px);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1;
      color: var(--color-ink);
      text-wrap: balance;
    }

    .v-thesis {
      margin: 0 0 26px;
      max-width: 28ch;
      font-size: clamp(18px, 2.2vw, 23px);
      line-height: 1.35;
      letter-spacing: -0.015em;
      color: #444;
      text-wrap: balance;
    }

    /* One line of record: what the venture is. */
    .v-record {
      margin: 0 0 40px;
      padding: 12px 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      font-family: var(--v-mono);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #8a857e;
    }

    .v-body p {
      margin: 0 0 22px;
      max-width: 64ch;
      font-size: 15px;
      line-height: 1.85;
      color: #444;
    }
    .v-body p.lead { font-size: 17px; line-height: 1.75; color: var(--color-ink); }

    /* Inline links inside body copy: marine, underlined at a readable offset. */
    .v-body a.v-inline {
      color: #1d5c63;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .v-body a.v-inline:hover { color: var(--color-ink); }
    .v-body a.v-inline:focus-visible { outline: 2px solid #1d5c63; outline-offset: 2px; }

    /* The namesake note is an aside, not argument: marine rule, smaller type,
       set off from the body so it reads as a margin gloss. */
    .v-namesake {
      margin: 34px 0 8px;
      padding-left: 18px;
      border-left: 2px solid #1d5c63;
      max-width: 58ch;
    }
    .v-namesake .label {
      display: block;
      margin-bottom: 8px;
      font-family: var(--v-mono);
      font-size: 10px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #1d5c63;
    }
    .v-namesake p {
      margin: 0;
      font-size: 14px;
      line-height: 1.75;
      color: #6b6660;
    }

    /* A bordered block rather than an underlined word: the underline sat
       detached from the text once the 44px tap target was applied. */
    .v-visit {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0 56px;
      min-height: 44px;
      padding: 0 18px;
      font-family: var(--v-mono);
      font-size: 11.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1d5c63;
      text-decoration: none;
      border: 1px solid #1d5c63;
      transition: background 180ms ease, color 180ms ease;
    }
    .v-visit:hover,
    .v-visit:focus-visible {
      background: #1d5c63;
      color: #f2f0eb;
    }
    .v-visit:focus-visible { outline: 2px solid #1d5c63; outline-offset: 2px; }
    .v-visit .arrow { font-size: 13px; line-height: 1; }

    /* Arrows are decoration; drop them on narrow screens. */
    @media (max-width: 767px) {
      .v-visit .arrow,
      .v-foot .arr { display: none; }
      .v-visit { gap: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
      .v-visit { transition: none; }
    }

    .v-foot {
      border-top: 1px solid var(--color-border);
      padding: 22px 0 56px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 12px 24px;
      font-family: var(--v-mono);
      font-size: 11.5px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .v-foot a { color: #8a857e; text-decoration: none; }
    .v-foot a:hover { color: var(--color-amber); }
  </style>

  <div class="v-shell">
    <nav class="v-crumb" aria-label="Breadcrumb">
      <a href="/">James Tannahill</a>
      &nbsp;/&nbsp;
      <a href="/#ventures">Ventures &amp; Platforms</a>
    </nav>

    <h1 class="v-title">{venture.name}</h1>
    <p class="v-thesis">{page.thesis}</p>

    <p class="v-record">
      {page.record.map((r) => (<span>{r}</span>))}
    </p>

    <div class="v-body">
      {page.body.map((para, i) => (
        <p class={i === 0 ? 'lead' : ''} set:html={linkify(para)} />
      ))}
    </div>

    {page.namesake && (
      <aside class="v-namesake">
        <span class="label">The name</span>
        <p>{page.namesake}</p>
      </aside>
    )}

    <a class="v-visit" href={venture.url} target="_blank" rel="noopener noreferrer">
      <span>{venture.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
      <span class="arrow" aria-hidden="true">&#8599;</span>
    </a>

    <nav class="v-foot" aria-label="More ventures">
      <a href={`/ventures/${prev.slug}/`}><span class="arr">&larr; </span>{prev.name}</a>
      <a href="/#ventures">All ventures</a>
      <a href={`/ventures/${next.slug}/`}>{next.name}<span class="arr"> &rarr;</span></a>
    </nav>
  </div>
</BaseLayout>
