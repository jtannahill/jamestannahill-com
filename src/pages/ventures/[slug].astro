---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { venturePages } from '../../data/ventures';
import { og } from '../../data/site-copy';

export function getStaticPaths() {
  return venturePages.map((v, i) => ({
    params: { slug: v.slug },
    props: {
      venture: v,
      // Prev/next walk the portfolio in its published order, wrapping at the ends.
      prev: venturePages[(i - 1 + venturePages.length) % venturePages.length],
      next: venturePages[(i + 1) % venturePages.length],
    },
  }));
}

const { venture, prev, next } = Astro.props;
const page = venture.page!;
const canonical = `https://jamestannahill.com/ventures/${venture.slug}`;

/** Escape first, then link, so body copy can never inject markup. */
function linkify(text: string): string {
  const html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
  return (page.links ?? []).reduce((acc, link) => {
    const needle = link.text
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
    return acc.replace(
      needle,
      `<a class="v-inline" href="${link.url}" target="_blank" rel="noopener noreferrer">${needle}</a>`
    );
  }, html);
}

const schema = [
  ...(page.app
    ? [{
        '@type': 'MobileApplication',
        '@id': `${canonical}#app`,
        name: venture.name,
        operatingSystem: 'iOS',
        applicationCategory: 'LifestyleApplication',
        url: page.app.url,
        description: page.app.line,
        publisher: { '@id': `${canonical}#organization` },
      }]
    : []),
  {
    '@type': 'Organization',
    '@id': `${canonical}#organization`,
    name: venture.name,
    url: venture.url,
    description: venture.description,
  },
  {
    '@type': 'WebPage',
    '@id': canonical,
    url: canonical,
    name: page.metaTitle,
    description: page.metaDescription,
    about: { '@id': `${canonical}#organization` },
    isPartOf: { '@id': 'https://jamestannahill.com/#website' },
    breadcrumb: {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'James Tannahill', item: 'https://jamestannahill.com/' },
        { '@type': 'ListItem', position: 2, name: 'Ventures & Platforms', item: 'https://jamestannahill.com/#ventures' },
        { '@type': 'ListItem', position: 3, name: venture.name, item: canonical },
      ],
    },
  },
];
---
<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={canonical}
  ogImage={og.venture(venture.slug)}
  ogImageAlt={`${venture.name} - ${page.thesis}`}
  ogType="website"
  extraSchema={schema}
>
  <style>
    .v-shell {
      max-width: 760px;
      margin: 0 auto;
      padding: 0 24px;
      /* Navigation and record lines share the one family, set small with
         tabular figures so dates and counts still line up. */
      --v-mono: 'NHG Display', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-variant-numeric: tabular-nums;
    }

    .v-crumb {
      border-bottom: 1px solid var(--color-border);
      padding: 18px 0;
      font-family: var(--v-mono);
      font-size: 13px;
      letter-spacing: 0.01em;
      color: var(--color-muted);
    }
    /* Padding grows the hit area to 44px without moving the line. */
    .v-crumb a { color: var(--color-muted); text-decoration: none; display: inline-block; padding: 13px 0; margin: -13px 0; }
    .v-crumb a:hover { color: var(--color-amber-text); }

    .v-title {
      margin: 52px 0 18px;
      font-family: 'NHG Display', sans-serif;
      font-size: clamp(36px, 6.5vw, 64px);
      font-weight: 500;
      letter-spacing: -0.035em;
      line-height: 1;
      color: var(--color-ink);
      text-wrap: balance;
    }

    .v-thesis {
      margin: 0 0 26px;
      max-width: 28ch;
      font-size: clamp(18px, 2.2vw, 23px);
      line-height: 1.35;
      letter-spacing: -0.015em;
      color: #444;
      text-wrap: balance;
    }

    /* One line of record: what the venture is. */
    .v-record {
      margin: 0 0 40px;
      padding: 12px 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      display: flex;
      flex-wrap: wrap;
      gap: 6px 14px;
      font-family: var(--v-mono);
      font-size: 13px;
      letter-spacing: 0.01em;
      color: var(--color-muted);
    }

    .v-body p {
      margin: 0 0 22px;
      max-width: 64ch;
      font-size: 15px;
      line-height: 1.85;
      color: #444;
    }
    .v-body p.lead { font-size: 17px; line-height: 1.75; color: var(--color-ink); }

    /* Inline links inside body copy: amber-text, underlined at a readable offset. */
    .v-body a.v-inline {
      color: var(--color-amber-text);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .v-body a.v-inline:hover { color: var(--color-ink); }
    .v-body a.v-inline:focus-visible { outline: 2px solid var(--color-amber-text); outline-offset: 2px; }

    /* The namesake note is an aside, not argument: hairline rule, smaller type,
       set off from the body so it reads as a margin gloss. */
    .v-namesake {
      margin: 34px 0 8px;
      padding-left: 18px;
      border-left: 1px solid var(--color-border);
      max-width: 58ch;
    }
    .v-namesake .label {
      display: block;
      margin-bottom: 8px;
      font-family: var(--v-mono);
      font-size: 13px;
      letter-spacing: 0.01em;
      color: var(--color-amber-text);
    }
    .v-namesake p {
      margin: 0;
      font-size: 14px;
      line-height: 1.75;
      color: var(--color-muted);
    }

    /* How it is built. Same body measure as the argument above it, with the
       spec set in mono as a two-column record rather than prose. */
    .v-tech {
      margin: 40px 0 8px;
      padding-top: 28px;
      border-top: 1px solid var(--color-border);
    }
    .v-tech h2 {
      margin: 0 0 20px;
      font-family: 'NHG Display', sans-serif;
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.02em;
      line-height: 1.15;
      color: var(--color-ink);
    }
    .v-spec {
      margin: 8px 0 0;
      max-width: 620px;
      display: grid;
      grid-template-columns: minmax(8rem, 13rem) 1fr;
      gap: 0;
      font-family: var(--v-mono);
      font-size: 13px;
      line-height: 1.6;
    }
    .v-spec dt {
      padding: 10px 16px 10px 0;
      border-top: 1px solid var(--color-border);
      letter-spacing: 0.01em;
      color: var(--color-muted);
    }
    .v-spec dd {
      margin: 0;
      padding: 10px 0;
      border-top: 1px solid var(--color-border);
      color: #444;
    }
    /* Stacked on narrow screens: the label sits over its value, and only the
       label keeps a rule so the pairs stay visibly paired. */
    @media (max-width: 599px) {
      .v-spec { grid-template-columns: 1fr; }
      .v-spec dt { padding-bottom: 2px; }
      .v-spec dd { padding-top: 0; border-top: 0; }
    }

    /* The app block sits between the argument and the visit link: icon, one
       line of what it is, and Apple's own badge, which must be shown as
       supplied rather than restyled. */
    .v-app {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-wrap: wrap;
      margin: 34px 0 8px;
      padding: 20px 0;
      border-top: 1px solid var(--color-border);
      border-bottom: 1px solid var(--color-border);
      max-width: 64ch;
    }
    .v-app img.icon {
      width: 72px;
      height: 72px;
      border-radius: 16px;
      flex: none;
    }
    .v-app .copy { flex: 1 1 240px; }
    .v-app .label {
      display: block;
      margin-bottom: 6px;
      font-family: var(--v-mono);
      font-size: 13px;
      letter-spacing: 0.01em;
      color: var(--color-amber-text);
    }
    .v-app p {
      margin: 0;
      font-size: 14px;
      line-height: 1.7;
      color: var(--color-muted);
    }
    .v-app .badge {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      flex: none;
    }
    .v-app .badge img { display: block; width: 150px; height: auto; }
    .v-app .badge:focus-visible { outline: 2px solid var(--color-amber-text); outline-offset: 4px; }

    /* A bordered block rather than an underlined word: the underline sat
       detached from the text once the 44px tap target was applied. */
    .v-visit {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin: 18px 0 56px;
      min-height: 44px;
      padding: 0 18px;
      font-family: var(--v-mono);
      font-size: 13px;
      letter-spacing: 0.01em;
      color: var(--color-amber-text);
      text-decoration: none;
      border: 1px solid var(--color-amber-text);
      transition: background 180ms var(--ease-out), color 180ms var(--ease-out), border-color 180ms var(--ease-out);
    }
    /* Hover takes the primary-button form: amber fill, ink label. */
    .v-visit:hover,
    .v-visit:focus-visible {
      background: var(--color-amber);
      border-color: var(--color-amber);
      color: var(--color-ink);
    }
    .v-visit:focus-visible { outline: 2px solid var(--color-amber-text); outline-offset: 2px; }
    .v-visit .arrow { flex: none; }

    @media (prefers-reduced-motion: reduce) {
      .v-visit { transition: none; }
    }

    .v-foot {
      border-top: 1px solid var(--color-border);
      padding: 22px 0 56px;
      /* Prev and next keep their arrows at every width; on phones "All
         ventures" takes its own row so direction never reads ambiguously. */
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 4px 24px;
      font-family: var(--v-mono);
      font-size: 13px;
      letter-spacing: 0.01em;
    }
    .v-foot a { color: var(--color-muted); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; gap: 0.5ch; }
    .v-foot a:hover { color: var(--color-amber-text); }
    .v-foot .next { justify-self: end; }
    @media (max-width: 599px) {
      .v-foot { grid-template-columns: 1fr 1fr; }
      .v-foot .all { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
    }
  </style>

  <div class="v-shell">
    <nav class="v-crumb" aria-label="Breadcrumb">
      <a href="/">James Tannahill</a>
      &nbsp;/&nbsp;
      <a href="/#ventures">Ventures &amp; Platforms</a>
    </nav>

    <h1 class="v-title">{venture.name}</h1>
    <p class="v-thesis">{page.thesis}</p>

    <p class="v-record">
      {page.record.map((r) => (<span>{r}</span>))}
    </p>

    <div class="v-body">
      {page.body.map((para, i) => (
        <p class={i === 0 ? 'lead' : ''} set:html={linkify(para)} />
      ))}
    </div>

    {page.namesake && (
      <aside class="v-namesake">
        <span class="label">The name</span>
        <p>{page.namesake}</p>
      </aside>
    )}

    {page.technical && (
      <section class="v-tech" aria-labelledby="how-it-is-built">
        <h2 id="how-it-is-built">How it is built</h2>
        <div class="v-body">
          {page.technical.body.map((para) => (<p set:html={linkify(para)} />))}
        </div>
        <dl class="v-spec">
          {page.technical.spec.map((row) => (
            <>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </>
          ))}
        </dl>
      </section>
    )}

    {page.app && (
      <div class="v-app">
        <img class="icon" src={page.app.icon} width="72" height="72" alt={`${venture.name} app icon`} />
        <div class="copy">
          <span class="label">On iPhone</span>
          <p>{page.app.line}</p>
        </div>
        <a class="badge" href={page.app.url} target="_blank" rel="noopener noreferrer">
          <img src="/app-store-badge.svg" width="150" height="50" alt="Download on the App Store" />
        </a>
      </div>
    )}

    <a class="v-visit" href={venture.url} target="_blank" rel="noopener noreferrer">
      <span>{venture.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
      <svg class="arrow" aria-hidden="true" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 8 8 2M3.5 2H8v4.5"/></svg>
    </a>

    <nav class="v-foot" aria-label="More ventures">
      <a href={`/ventures/${prev.slug}`}><span aria-hidden="true">&larr;</span>{prev.name}</a>
      <a class="all" href="/#ventures">All ventures</a>
      <a class="next" href={`/ventures/${next.slug}`}>{next.name}<span aria-hidden="true">&rarr;</span></a>
    </nav>
  </div>
</BaseLayout>
